import os

# One CS2 SDK target -> one Metamod binary.
for sdk_target in MMSPlugin.sdk_targets:
    sdk = sdk_target.sdk
    cxx = sdk_target.cxx

    cxx.cxxflags += ['-Wno-invalid-offsetof']

    # HL2Library already adds the current Source 2 SDK implementation sources
    # in AMBuildScript. Do not add tier1/entity2 sources again here.
    binary = MMSPlugin.HL2Library(
        builder,
        cxx,
        MMSPlugin.plugin_name,
        sdk
    )

    binary.custom = [
        builder.tools.Protoc(
            protoc=sdk_target.protoc,
            sources=[
                os.path.join(
                    sdk['path'],
                    'common',
                    'network_connection.proto'
                )
            ]
        )
    ]

    binary.compiler.cxxincludes += [
        os.path.join(builder.sourcePath, 'include'),
        os.path.join(builder.sourcePath, '..', 'SchemaEntity'),
    ]

    binary.sources += [
        'vip_viewmodelfov.cpp',
        os.path.join('..', 'SchemaEntity', 'schemasystem.cpp'),
    ]

    if cxx.target.arch == 'x86':
        binary.sources += [
            'sourcehook/sourcehook_hookmangen.cpp'
        ]

    nodes = builder.Add(binary)
    MMSPlugin.binaries += [nodes]
